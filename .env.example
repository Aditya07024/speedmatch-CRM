# Local PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speedmatch

# Secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# API server port
PORT=8095

# Clerk Authentication Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Super Admin master access password
SUPERADMIN_PASSWORD=SpeedMatchSuper2026!
SUPERADMIN_EMAIL=superadmin@speedmatch.com
